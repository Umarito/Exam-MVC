@model IEnumerable<Post>
@{
    ViewData["Title"] = "Posts";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Posts</h2>
        <a asp-controller="Posts" asp-action="Create" class="btn btn-primary">Create Post</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Id</th>
                                <th>Title</th>
                                <th>Text</th>
                                <th style="width: 180px;">Published</th>
                                <th class="text-end" style="width: 280px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Title</td>
                                    <td class="text-truncate" style="max-width: 300px;">@item.Text</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-controller="Posts" asp-action="GetById" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                            <a asp-controller="Posts" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Update</a>
                                            <form asp-controller="Posts" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this post?');">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">No posts found. Create your first post.</div>
            }
        </div>
    </div>
</div>