@model Post
@{
    ViewData["Title"] = "Update Post";
}

<div class="container py-4" style="max-width: 840px;">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h3 class="mb-0">Update Post</h3>
        </div>
        <div class="card-body">
            <form method="post" class="row g-3">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-3">
                    <label class="form-label">Id</label>
                    <input value="@Model.Id" class="form-control" disabled />
                </div>

                <div class="col-md-9">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Text" class="form-label"></label>
                    <textarea asp-for="Text" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Text" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Tags</label>
                    <select name="selectedTagIds" class="form-select" multiple size="6">
                        @foreach (var tag in (IEnumerable<Tag>)ViewBag.Tags)
                        {
                            var selectedIds = (IEnumerable<int>)ViewBag.SelectedTagIds;
                            var isSelected = selectedIds.Contains(tag.Id);
                            if (isSelected)
                            {
                                <option value="@tag.Id" selected>@tag.Name</option>
                            }
                            else
                            {
                                <option value="@tag.Id">@tag.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
