@model Tag
@{
    ViewData["Title"] = "Tag Details";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Tag Details</h3>
            <span class="badge text-bg-light">#@Model.Id</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-4">Related Posts</dt>
                <dd class="col-sm-8">
                    @if (Model.Posts != null && Model.Posts.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var post in Model.Posts)
                            {
                                <li>
                                    <a asp-controller="Posts" asp-action="GetById" asp-route-id="@post.Id">@post.Title</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No posts related to this tag.</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-white d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>
